# Copy this file to backend/.env. Settings always resolves that exact file,
# regardless of whether uvicorn, the worker, or a CLI is launched from another
# working directory. Real secrets belong only in backend/.env or a secret
# manager; never commit them.

# Core local SaaS
APP_NAME="PEKA SaaS API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://peka:peka@localhost:5432/peka_saas
LOG_LEVEL=INFO

# Replace this local-only placeholder in backend/.env.
PLATFORM_ADMIN_JWT_SECRET=change-me-local-only
PLATFORM_ADMIN_JWT_ALGORITHM=HS256
TENANT_SSO_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
PLATFORM_ADMIN_ACCESS_TOKEN_MINUTES=60

# Durable local source objects. PostgreSQL and this directory are the system
# of record; Qdrant remains a rebuildable derived index.
PEKA_OBJECT_STORAGE_BACKEND=local
PEKA_OBJECT_STORAGE_LOCAL_ROOT=/tmp/peka-saas-documents
PEKA_INGESTION_MAX_UPLOAD_BYTES=52428800
PEKA_DOCUMENT_IDEMPOTENCY_HOURS=24

# Pinned local Qdrant from docker-compose.qdrant.yml.
PEKA_QDRANT_URL=http://localhost:6333
PEKA_QDRANT_COLLECTION=peka_document_chunks
PEKA_QDRANT_API_KEY=
PEKA_QDRANT_TIMEOUT_SECONDS=30
PEKA_QDRANT_TLS_VERIFY=true

# Native Ollama through its OpenAI-compatible endpoint. Ollama does not require
# an API key locally; PEKA sends Authorization only when this value is nonempty.
PEKA_EMBEDDING_PROVIDER=openai-compatible
PEKA_EMBEDDING_BASE_URL=http://localhost:11434/v1
PEKA_EMBEDDING_API_KEY=
PEKA_EMBEDDING_MODEL=nomic-embed-text
PEKA_EMBEDDING_DIMENSION=768
PEKA_EMBEDDING_BATCH_SIZE=64
PEKA_EMBEDDING_TIMEOUT_SECONDS=30

# The worker is a separate native process. Concurrency is intentionally fixed
# at one until multi-process capacity controls are introduced.
PEKA_INGESTION_WORKER_ENABLED=true
PEKA_INGESTION_WORKER_POLL_SECONDS=2
PEKA_INGESTION_WORKER_CONCURRENCY=1
PEKA_INGESTION_WORKER_STALE_JOB_SECONDS=600
PEKA_INGESTION_WORKER_HEARTBEAT_STALE_SECONDS=60

# Retry policy for transient embedding/Qdrant failures.
PEKA_INGESTION_JOB_MAX_ATTEMPTS=5
PEKA_INGESTION_RETRY_BASE_SECONDS=2
PEKA_INGESTION_RETRY_MAX_SECONDS=300

# Stateless grounded answers through native Ollama's OpenAI-compatible API.
# Chat is independent from embeddings: a chat outage does not stop ingestion.
PEKA_CHAT_PROVIDER=openai-compatible
PEKA_CHAT_BASE_URL=http://localhost:11434/v1
PEKA_CHAT_API_KEY=
PEKA_CHAT_MODEL=qwen3:8b
PEKA_CHAT_TIMEOUT_SECONDS=120
PEKA_CHAT_MAX_OUTPUT_TOKENS=768
PEKA_CHAT_TEMPERATURE=0.1
PEKA_CHAT_CONTEXT_WINDOW=4096
PEKA_CHAT_STREAMING_ENABLED=true
PEKA_CHAT_HEALTH_CACHE_SECONDS=60

# Grounding and prompt budgets. Retrieval currently uses the Knowledge Service
# cosine-score contract; tune the score only with representative tenant data.
PEKA_AI_MIN_RETRIEVAL_SCORE=0.60
PEKA_AI_MIN_EVIDENCE_RESULTS=1
PEKA_AI_MAX_QUERY_CHARACTERS=2000
PEKA_AI_MAX_TOP_K=25
PEKA_AI_DEFAULT_TOP_K=8
PEKA_AI_MAX_EVIDENCE_CHARACTERS_PER_CHUNK=6000
PEKA_AI_MAX_PRIOR_MESSAGES=8
PEKA_AI_MAX_HISTORY_TOKENS=1200
PEKA_AI_MAX_EVIDENCE_TOKENS=2200
PEKA_AI_MAX_TOTAL_PROMPT_TOKENS=4096
PEKA_AI_SECRET_DETECTION_ENABLED=true
